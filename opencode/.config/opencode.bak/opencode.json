{
    "$schema": "https://opencode.ai/config.json",
    "tui" : {
        "scroll_speed": 3,
        "scroll_acceleration": {
            "enabled": true
        },
        "diff_style": "auto"
    },
      "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": ["http://localhost:5173"]
      },
    "mcp" : {
        "google-workspace": {
            "enabled": true,
            "type":"local",
            "command" : ["node", "/home/mark/AI/mcp-google-workspace/dist/index.js" ] 
        },
        "confluence": {
            "type": "local",
            "command": ["node", "/home/mark/AI/mcp-confluence/build/index.js"],
            "enabled": false,
            "environment": {
                "CONFLUENCE_BASE_URL": "https://totd-ci.atlassian.net/wiki",
                "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}",
                "CONFLUENCE_EMAIL": "mark.lambert@halfords.co.uk"
            }
        },
        "outlook-calendar": {
            "enabled": false,
            "type":"local",
            "command" : ["node", "/home/mark/AI/mcp-outlook-calendar/dist/index.js" ],
            "environment": {
                "OUTLOOK_EMAIL": "{env:OUTLOOK_EMAIL}",
                "OUTLOOK_PASSWORD": "{env:OUTLOOK_PASSWORD}",
                "EWS_HOST": "https://outlook.office365.com",
                "EWS_AUTH": "ntlm"
            }
        },
        "docling": {
            "enabled": false,
            "type": "local",
            "command": ["uvx", "--from=docling-mcp", "docling-mcp-server"]
        }
    }
}